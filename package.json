{
  "name": "@rozsival/panther-minor",
  "version": "13.1.0",
  "private": true,
  "description": "Self-hosted AI workstation stack for AMD",
  "repository": {
    "type": "git",
    "url": "https://github.com/rozsival/panther-minor.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:cli": "bashly generate",
    "check": "pnpx concurrently --kill-others-on-fail --prefix-colors auto \"pnpm run check:code\" \"pnpm run check:misc\" \"pnpm run check:sh\"",
    "check:code": "biome check .",
    "check:misc": "prettier --check .",
    "check:sh": "shellcheck bin/panther-minor */entrypoint.sh",
    "fix": "pnpx concurrently --kill-others-on-fail --prefix-colors auto \"pnpm run fix:code\" \"pnpm run format:misc\"",
    "fix:code": "ultracite fix .",
    "fix:code:unsafe": "pnpm run fix:code --unsafe",
    "format": "pnpx concurrently --kill-others-on-fail --prefix-colors auto \"pnpm run format:code\" \"pnpm run format:misc\"",
    "format:code": "biome format --write .",
    "format:misc": "prettier --check --write .",
    "postinstall": "is-ci || lefthook install",
    "lint": "biome lint .",
    "test": "node --test \"**/*.test.js\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "is-ci": "4.1.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-sh": "0.20.2",
    "prettier-plugin-toml": "4.1.0",
    "shellcheck": "4.1.0",
    "typescript": "6.0.3",
    "ultracite": "8.0.1"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.x"
  }
}
