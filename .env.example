# -- llama.cpp ----------------------------------------------------------------
# Upstream release tag. v0.7.0 is the first with the GPU cache for host-memory MoE
# experts (`moe-cache-mib`, ggml-org/llama.cpp#29887) that Qwen3.8-Flash-Next's
# placement relies on - see docs/llm.md#moe-expert-cache. Its MTP graph for
# `qwen4exp` (v0.6.0+, ggml-org/llama.cpp#29761) cannot borrow tensors across GGUFs,
# so the draft head must be a self-contained one - see docs/llm.md#-speculative-decoding.
LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp
LLAMA_CPP_REF=v0.7.0
LLAMA_CPP_BATCH_SIZE=4096
LLAMA_CPP_CACHE_RAM=8192
LLAMA_CPP_MODELS_MAX=3
LLAMA_CPP_PARALLEL=1
LLAMA_CPP_SLEEP_IDLE_SECONDS=900
LLAMA_CPP_UBATCH_SIZE=1024
# GPU sets the LLMs run on, selected by the CLI into ROCM_VISIBLE_DEVICES:
# `models t2i load --exclusive` shrinks the LLMs to the SHARED set (freeing
# SD_VISIBLE_DEVICES for stable-diffusion.cpp alone), `models t2i unload`
# restores the STANDALONE set (all GPUs).
LLAMA_CPP_GPUS_STANDALONE=0,1
LLAMA_CPP_GPUS_SHARED=0

# -- stable-diffusion.cpp -----------------------------------------------------
SD_CPP_REPO=https://github.com/leejet/stable-diffusion.cpp
# Qwen-Image-2.1 needs master-883 (leejet/stable-diffusion.cpp#1994) or newer.
SD_CPP_REF=master-929-3f8527a
SD_CPP_SLEEP_IDLE_SECONDS=900

# Active text-to-image model and its component files, given as <repository>/<file>
# paths inside the shared Hugging Face cache. Managed by
# `./bin/panther-minor models t2i load <model>` — sd-server loads exactly one model, so
# only one is ever resident. Leave a component empty when the model omits it
# (e.g. Qwen-Image has no unconditional diffusion model).
SD_CPP_MODEL=Qwen-Image-2.1
SD_CPP_DIFFUSION_MODEL=unsloth/Qwen-Image-2.1-GGUF/qwen-image-2.1-Q8_0.gguf
SD_CPP_UNCOND_DIFFUSION_MODEL=
SD_CPP_LLM=unsloth/Qwen3-VL-8B-Instruct-GGUF/Qwen3-VL-8B-Instruct-UD-Q4_K_XL.gguf
SD_CPP_VAE=unsloth/Qwen-Image-2.1-FP8/vae/qwen_image_2.1_vae_bf16.safetensors
SD_CPP_MODEL_ARGS="--cfg-scale 6.0 --sampling-method euler --steps 20 -v"
# GPU(s) dedicated to image generation, pinned away from the LLMs to avoid VRAM contention
SD_VISIBLE_DEVICES=1

# -- ROCm ---------------------------------------------------------------------
ROCM_ARCH=gfx1201

# Active GPU set the LLMs run on. Managed by the CLI: `models t2i load --exclusive`
# sets it to LLAMA_CPP_GPUS_SHARED to dedicate a GPU to image generation, and
# `models t2i unload` restores it to LLAMA_CPP_GPUS_STANDALONE.
ROCM_VISIBLE_DEVICES=0,1

# -- Permission settings ------------------------------------------------------
HOST_UID=1000
HOST_GID=1000
VIDEO_GID=44
RENDER_GID=992

# -- Published-port binding ---------------------------------------------------
# Address the proxy publishes its ports on, alongside 127.0.0.1. Docker's
# published-port DNAT rules match the bound address, so binding this to the
# node's Tailscale IP is what keeps the services off the public internet -
# `ufw deny` cannot do it, because DNAT'd traffic is forwarded and never
# traverses the INPUT chain (moby/moby#17496).
#
# Managed by the CLI: `setup env` fills it from `tailscale ip -4`. Re-run
# `sudo ./bin/panther-minor setup env` after `sudo tailscale up`. Left empty, the cluster
# refuses to start rather than publishing to 0.0.0.0.
BIND_ADDR=

# -- Hugging Face -------------------------------------------------------------
HF_TOKEN=
