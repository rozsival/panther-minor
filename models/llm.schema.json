{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Configuration schema for models",
  "properties": {
    "models": {
      "description": "List of models",
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Name of the model",
            "type": "string"
          },
          "components": {
            "description": "Weight files that make up the model, stored in the shared cache at <repository>/<file>. The first component is the main model weight",
            "items": {
              "additionalProperties": false,
              "properties": {
                "repository": {
                  "description": "Hugging Face repository containing the file",
                  "type": "string"
                },
                "file": {
                  "description": "Path of the file inside the repository",
                  "type": "string"
                }
              },
              "required": ["repository", "file"],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": ["name", "components"],
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "description": "Configuration version",
      "type": "string"
    }
  },
  "required": ["version", "models"],
  "title": "Models Configuration",
  "type": "object"
}
