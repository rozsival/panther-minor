      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * sum by (instance, mode) (rate(node_cpu_seconds_total{job=\"node\", instance=~\"$instance\", mode!~\"idle|guest|guest_nice\"}[$__rate_interval])) / on (instance) group_left count by (instance) (node_cpu_seconds_total{job=\"node\", instance=~\"$instance\", mode=\"idle\"})",
          "legendFormat": "{{mode}}",
          "refId": "A",
          "range": true
        }
      ],
      "title": "CPU Usage",
      "type": "timeseries",
      "description": "Busy time by mode as a share of all logical CPUs; the stack top is total CPU usage. Guest time is already counted in user/nice."
    },
