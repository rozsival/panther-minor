    # :command.usage_options
    printf "%s\n" "Options:"

    # :command.usage_flags
    # :flag.usage
    printf "  %s\n" "--force, -f"
    printf "    Re-download even if the model's files already exist\n"
    echo

    # :command.usage_fixed_flags
    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo

    # :command.usage_args
    printf "%s\n" "Arguments:"

    # :argument.usage
    printf "  %s\n" "MODEL"
    printf "    Model name from models/llm.config.json\n"
    echo

    # :command.usage_environment_variables
    printf "%s\n" "Environment Variables:"

    # :environment_variable.usage
    printf "  %s\n" "HF_TOKEN"
    printf "    Hugging Face token used by hf download\n"
    echo

    # :command.usage_examples
    printf "%s\n" "Examples:"
    printf "  cli models llm download Qwen3.5-35B-A3B\n"
    printf "  HF_TOKEN=token cli models llm download Qwen3.5-35B-A3B\n"
    echo

  fi
}

