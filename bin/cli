  echo $'      ;;'
  echo $''
  echo $'    \'setup ssh\'*)'
  echo $'      while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "$(_cli_completions_filter "--allowed-user --help --ssh-port -h -p -u")" -- "$cur")'
  echo $'      ;;'
  echo $''
  echo $'    \'setup ufw\'*)'
  echo $'      while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "$(_cli_completions_filter "--help --ssh-port -h -p")" -- "$cur")'
  echo $'      ;;'
  echo $''
  echo $'    \'setup git\'*)'
  echo $'      while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "$(_cli_completions_filter "--allowed-user --help --server-name -h -n -u")" -- "$cur")'
  echo $'      ;;'
