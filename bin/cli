  if [[ -n "$long_usage" ]]; then
    # :command.usage_options
    printf "%s\n" "Options:"

    # :command.usage_flags
    # :flag.usage
    printf "  %s\n" "--tokens, -n COUNT"
    printf "    Tokens to predict per run (defaults to 256)\n"
    echo

    # :flag.usage
    printf "  %s\n" "--runs, -r COUNT"
    printf "    Measured runs after the discarded warm-up (defaults to 3)\n"
    echo

    # :flag.usage
    printf "  %s\n" "--log-path, -l PATH"
    printf "    File to append the baseline to (defaults to models/bench.log)\n"
    echo

    # :command.usage_fixed_flags
    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo

    # :command.usage_args
    printf "%s\n" "Arguments:"

    # :argument.usage
    printf "  %s\n" "MODEL"
    printf "    Preset name from llama-cpp/preset.ini\n"
    echo

    # :command.usage_examples
    printf "%s\n" "Examples:"
    printf "  cli models llm bench Qwen3.8-27B\n"
    printf "  cli models llm bench --runs 5 --tokens 512 Qwen3.8-27B\n"
    echo

  fi
}

