# :command.parse_requirements
cli_models_llm_bench_parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        cli_models_llm_bench_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.command_filter
  action="models llm bench"

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      # :flag.case
      --tokens | -n)

        # :flag.case_arg
        if [[ -n ${2+x} ]]; then
          args['--tokens']="$2"
          shift
          shift
        else
          printf "%s\n" "--tokens requires an argument: --tokens, -n COUNT" >&2
          exit 1
        fi
        ;;

      # :flag.case
      --runs | -r)

        # :flag.case_arg
        if [[ -n ${2+x} ]]; then
          args['--runs']="$2"
          shift
          shift
        else
          printf "%s\n" "--runs requires an argument: --runs, -r COUNT" >&2
          exit 1
        fi
        ;;

      # :flag.case
      --log-path | -l)

        # :flag.case_arg
        if [[ -n ${2+x} ]]; then
          args['--log-path']="$2"
          shift
          shift
        else
          printf "%s\n" "--log-path requires an argument: --log-path, -l PATH" >&2
          exit 1
        fi
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        # :argument.case
        if [[ -z ${args['model']+x} ]]; then
          args['model']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

        ;;

    esac
  done

  # :command.required_args_filter
  if [[ -z ${args['model']+x} ]]; then
    printf "missing required argument: MODEL\nusage: cli models llm bench MODEL [OPTIONS]\n" >&2

    exit 1
  fi

  # :command.validations
  # :argument.validations
  if [[ -v args['model'] ]]; then
    validation_output="$(validate_loadable_llm "${args['model']:-}")"
    if [[ -n "$validation_output" ]]; then
      printf "validation error in %s:\n%s\n" "MODEL" "$validation_output" >&2
      exit 1
    fi
  fi

  # :flag.validations
  if [[ -v args['--tokens'] ]]; then
    validation_output="$(validate_integer "${args['--tokens']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--tokens, -n COUNT" "$validation_output" >&2
      exit 1
    fi
  fi

  # :flag.validations
  if [[ -v args['--runs'] ]]; then
    validation_output="$(validate_integer "${args['--runs']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--runs, -r COUNT" "$validation_output" >&2
      exit 1
    fi
  fi

}

# :command.parse_requirements
cli_models_t2i_parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        cli_models_t2i_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.command_filter
  action=${1:-}

  case $action in
    -*) ;;

    download)
      action="download"
      shift
      cli_models_t2i_download_parse_requirements "$@"
      shift $#
      ;;

    list)
      action="list"
      shift
      cli_models_t2i_list_parse_requirements "$@"
      shift $#
      ;;

    remove)
      action="remove"
      shift
      cli_models_t2i_remove_parse_requirements "$@"
      shift $#
      ;;

    load)
      action="load"
      shift
      cli_models_t2i_load_parse_requirements "$@"
      shift $#
      ;;

    unload)
      action="unload"
      shift
      cli_models_t2i_unload_parse_requirements "$@"
      shift $#
      ;;

    # :command.command_fallback
    "")
      cli_models_t2i_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

# :command.parse_requirements
