  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        cli_models_t2i_download_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.environment_variables_filter

  env_var_names+=("HF_TOKEN")

  # :command.command_filter
  action="models t2i download"

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      # :flag.case
      --force | -f)

        # :flag.case_no_arg
        args['--force']=1
        shift
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        # :argument.case
        if [[ -z ${args['model']+x} ]]; then
          args['model']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

        ;;

    esac
  done

  # :command.required_args_filter
  if [[ -z ${args['model']+x} ]]; then
    printf "missing required argument: MODEL\nusage: cli models t2i download MODEL [OPTIONS]\n" >&2

    exit 1
  fi

  # :command.validations
  # :argument.validations
  if [[ -v args['model'] ]]; then
    validation_output="$(validate_supported_t2i "${args['model']:-}")"
    if [[ -n "$validation_output" ]]; then
      printf "validation error in %s:\n%s\n" "MODEL" "$validation_output" >&2
      exit 1
    fi
  fi

}

