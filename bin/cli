  echo $''
  echo $'    \'models llm load\'*)'
  echo $'      while read -r; do COMPREPLY+=("$REPLY"); done < <(compgen -W "$(_cli_completions_filter "$(cd "$(git rev-parse --show-toplevel)" && awk -F\'[][]\' \'NF==3{print $2}\' llama-cpp/preset.ini) --help -h")" -- "$cur")'
