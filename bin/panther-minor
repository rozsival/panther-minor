  printf "  panther-minor models t2i load --help | -h\n"
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "Options:"

    printf "  %s\n" "--exclusive, -e"
    printf "    Dedicate the image GPU(s) to sd-server by moving the LLMs off them (restarts\n    llama.cpp; undo with unload)\n"
    echo

    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo

    printf "%s\n" "Arguments:"

    printf "  %s\n" "MODEL"
    printf "    Model name from models/t2i.config.json\n"
    echo

    printf "%s\n" "Examples:"
    printf "  panther-minor models t2i load Qwen-Image-2.1\n"
    printf "  panther-minor models t2i load --exclusive Qwen-Image-2.1\n"
    echo

  fi
}

