panther_minor_cluster_build_completion() {
  local completion_current="$1"
  local completion_arg_index=0
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help | -h)
        completion_blocked_flags["--help"]=1
        shift
        ;;
      --no-cache | -n)
        completion_blocked_flags["--no-cache"]=1

        shift
        ;;
      *)
        if [[ $completion_arg_index -lt 0 ]]; then
          completion_arg_index=$((completion_arg_index + 1))
        fi
        shift

        ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
    completion_flag_candidates --no-cache "$completion_current" --no-cache -n
  fi

  if [[ $completion_current != -* ]]; then
    case "$completion_arg_index" in
      0)
        if completion_output="$({ panther_complete_services; } 2>/dev/null)"; then
          completion_dynamic_candidates "$completion_current" "$completion_output"
        fi
        ;;
    esac
  fi

}

panther_minor_logs_completion() {
  local completion_current="$1"
  local completion_arg_index=0
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help | -h)
        completion_blocked_flags["--help"]=1
        shift
        ;;
      --tail | -t)
        shift
        if [[ $# -eq 0 ]]; then

          return
        fi
        shift
        completion_blocked_flags["--tail"]=1

        ;;
      *)
        if [[ $completion_arg_index -ge 1 ]]; then
          return
        fi
        completion_arg_index=$((completion_arg_index + 1))
        shift

        ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
    completion_flag_candidates --tail "$completion_current" --tail -t
  fi

  if [[ $completion_current != -* ]]; then
    case "$completion_arg_index" in
      0)
        if completion_output="$({ panther_complete_services; } 2>/dev/null)"; then
          completion_dynamic_candidates "$completion_current" "$completion_output"
        fi
        ;;
    esac
  fi

}

panther_minor_update_completion() {
  local completion_current="$1"
  local completion_arg_index=0
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help | -h)
        completion_blocked_flags["--help"]=1
        shift
        ;;
      *)
        if [[ $completion_arg_index -ge 1 ]]; then
          return
        fi
        completion_arg_index=$((completion_arg_index + 1))
        shift

        ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

}

panther_minor_install_completion() {
  local completion_current="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help | -h)
        completion_blocked_flags["--help"]=1
        shift
        ;;
      *)
        return
        ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

}

panther_minor_completions_completion() {
  local completion_current="$1"
  local completion_arg_index=0
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help | -h)
        completion_blocked_flags["--help"]=1
        shift
        ;;
      *)
        if [[ $completion_arg_index -ge 1 ]]; then
          return
        fi
        completion_arg_index=$((completion_arg_index + 1))
        shift

        ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

  if [[ $completion_current != -* ]]; then
    case "$completion_arg_index" in
      0)
        local -a completion_values=(
          "bash"
          "zsh"
        )
        completion_candidates "$completion_current" "${completion_values[@]}"
        ;;
    esac
  fi

}

before_hook() {
  :

}

after_hook() {
  :

}

initialize() {
  declare -g version="16.0.0"
  set -euo pipefail

  PANTHER_REPO_ROOT="$(panther_repo_root)"
  declare -gr PANTHER_REPO_ROOT
  declare -gr PANTHER_CLI_BIN="$PANTHER_REPO_ROOT/bin/panther-minor"
  declare -gr PANTHER_MODELS_DIR="$PANTHER_REPO_ROOT/models"
  declare -gr PANTHER_ENV_FILE="$PANTHER_REPO_ROOT/.env"
  declare -gr PANTHER_ENV_EXAMPLE_FILE="$PANTHER_REPO_ROOT/.env.example"
  declare -gr PANTHER_GITHUB_REPO="rozsival/panther-minor"
  declare -gr PANTHER_RELEASE_ASSET="panther-minor.tar.gz"
  declare -gr PANTHER_INSTALL_COMMAND="curl -fsSL https://github.com/$PANTHER_GITHUB_REPO/releases/latest/download/install.sh | bash"

  panther_is_logs_service() {
    case "${1:-}" in
    llama-cpp | llama-manager | llama-metrics-exporter | stable-diffusion-cpp | sd-manager | sd-metrics-exporter | open-webui | prometheus | grafana | node-exporter | amd-gpu-exporter | proxy | ts-proxy)
      return 0
      ;;
    *)
      return 1
      ;;
    esac
  }

  panther_normalize_logs_tail_args() {
    [[ ${#command_line_args[@]} -ge 3 ]] || return 0
    [[ ${command_line_args[0]} == 'logs' ]] || return 0
    panther_is_logs_service "${command_line_args[1]}" || return 0

    local -a normalized_args=()
    local index=0

    while ((index < ${#command_line_args[@]})); do
      local current_arg="${command_line_args[$index]}"
      local next_arg="${command_line_args[$((index + 1))]:-}"

      normalized_args+=("$current_arg")

      if [[ $current_arg == '--tail' ]] && [[ -z $next_arg || $next_arg == -* ]]; then
        normalized_args+=('100')
      fi

      ((index += 1))
    done

    command_line_args=("${normalized_args[@]}")
  }

  panther_normalize_logs_tail_args

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"
  before_hook

  case "$action" in
    "setup") panther_minor_setup_command ;;
    "setup all") panther_minor_setup_all_command ;;
    "setup check") panther_minor_setup_check_command ;;
    "setup deps") panther_minor_setup_deps_command ;;
    "setup amdgpu") panther_minor_setup_amdgpu_command ;;
    "setup grub") panther_minor_setup_grub_command ;;
    "setup memory") panther_minor_setup_memory_command ;;
    "setup env") panther_minor_setup_env_command ;;
    "models") panther_minor_models_command ;;
    "models llm") panther_minor_models_llm_command ;;
    "models llm download") panther_minor_models_llm_download_command ;;
    "models llm list") panther_minor_models_llm_list_command ;;
    "models llm remove") panther_minor_models_llm_remove_command ;;
    "models llm load") panther_minor_models_llm_load_command ;;
    "models llm unload") panther_minor_models_llm_unload_command ;;
    "models llm bench") panther_minor_models_llm_bench_command ;;
    "models t2i") panther_minor_models_t2i_command ;;
    "models t2i download") panther_minor_models_t2i_download_command ;;
    "models t2i list") panther_minor_models_t2i_list_command ;;
    "models t2i remove") panther_minor_models_t2i_remove_command ;;
    "models t2i load") panther_minor_models_t2i_load_command ;;
    "models t2i unload") panther_minor_models_t2i_unload_command ;;
    "models prune") panther_minor_models_prune_command ;;
    "cluster") panther_minor_cluster_command ;;
    "cluster start") panther_minor_cluster_start_command ;;
    "cluster status") panther_minor_cluster_status_command ;;
    "cluster stop") panther_minor_cluster_stop_command ;;
    "cluster cleanup") panther_minor_cluster_cleanup_command ;;
    "cluster restart") panther_minor_cluster_restart_command ;;
    "cluster build") panther_minor_cluster_build_command ;;
    "logs") panther_minor_logs_command ;;
    "update") panther_minor_update_command ;;
    "install") panther_minor_install_command ;;
    "completions") panther_minor_completions_command ;;
  esac

  after_hook
}

start() {
  if [[ ${1:-} == "__complete" ]]; then
    completion_run "${@:2}"
    return
  fi

  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
}

start "$@"
