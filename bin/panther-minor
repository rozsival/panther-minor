panther_minor_cluster_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        panther_minor_cluster_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action=${1:-}

  case $action in
    -*) ;;

    start)
      action="start"
      shift
      panther_minor_cluster_start_parse_requirements "$@"
      shift $#
      ;;

    status)
      action="status"
      shift
      panther_minor_cluster_status_parse_requirements "$@"
      shift $#
      ;;

    stop)
      action="stop"
      shift
      panther_minor_cluster_stop_parse_requirements "$@"
      shift $#
      ;;

    cleanup)
      action="cleanup"
      shift
      panther_minor_cluster_cleanup_parse_requirements "$@"
      shift $#
      ;;

    restart)
      action="restart"
      shift
      panther_minor_cluster_restart_parse_requirements "$@"
      shift $#
      ;;

    build)
      action="build"
      shift
      panther_minor_cluster_build_parse_requirements "$@"
      shift $#
      ;;

    "")
      panther_minor_cluster_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

panther_minor_cluster_start_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        panther_minor_cluster_start_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="cluster start"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --remove-orphans | -r)

        args['--remove-orphans']=1
        shift
        ;;

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          escaped="$(printf '%q' "$1")"
          if [[ -z ${args['service']+x} ]]; then
            args['service']="$escaped"
          else
            args['service']="${args['service']} $escaped"

          fi
          shift

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        escaped="$(printf '%q' "$1")"
        if [[ -z ${args['service']+x} ]]; then
          args['service']="$escaped"
        else
          args['service']="${args['service']} $escaped"

        fi
        shift

        ;;

    esac
  done

  if [[ -v args['service'] ]]; then
    values=''
    eval "values=(${args['service']})"
    for value in "${values[@]}"; do
      validation_output="$(validate_cluster_service "$value")"
      if [[ -n "$validation_output" ]]; then
        printf "validation error in %s:\n%s\n" "SERVICE" "$validation_output" >&2
        exit 1
      fi
    done
  fi

}

