panther_minor_cluster_completion() {
  local completion_current="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      start)
        shift
        panther_minor_cluster_start_completion "$completion_current" "$@"
        return
        ;;
      status)
        shift
        panther_minor_cluster_status_completion "$completion_current" "$@"
        return
        ;;
      stop)
        shift
        panther_minor_cluster_stop_completion "$completion_current" "$@"
        return
        ;;
      cleanup)
        shift
        panther_minor_cluster_cleanup_completion "$completion_current" "$@"
        return
        ;;
      restart)
        shift
        panther_minor_cluster_restart_completion "$completion_current" "$@"
        return
        ;;
      build)
        shift
        panther_minor_cluster_build_completion "$completion_current" "$@"
        return
        ;;
      --help | -h)
        completion_blocked_flags["--help"]=1
        shift
        ;;
      *)
        return
        ;;
    esac
  done
  completion_candidates "$completion_current" start status stop cleanup restart build

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

}

panther_minor_cluster_start_completion() {
  local completion_current="$1"
  local completion_arg_index=0
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help | -h)
        completion_blocked_flags["--help"]=1
        shift
        ;;
      --remove-orphans | -r)
        completion_blocked_flags["--remove-orphans"]=1

        shift
        ;;
      *)
        if [[ $completion_arg_index -lt 0 ]]; then
          completion_arg_index=$((completion_arg_index + 1))
        fi
        shift

        ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
    completion_flag_candidates --remove-orphans "$completion_current" --remove-orphans -r
  fi

  if [[ $completion_current != -* ]]; then
    case "$completion_arg_index" in
      0)
        if completion_output="$({ panther_complete_services; } 2>/dev/null)"; then
          completion_dynamic_candidates "$completion_current" "$completion_output"
        fi
        ;;
    esac
  fi

}

panther_minor_cluster_status_completion() {
  local completion_current="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help | -h)
        completion_blocked_flags["--help"]=1
        shift
