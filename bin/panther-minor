panther_minor_models_llm_bench_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        panther_minor_models_llm_bench_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="models llm bench"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --tokens | -n)

        if [[ -n ${2+x} ]]; then
          args['--tokens']="$2"
          shift
          shift
        else
          printf "%s\n" "--tokens requires an argument: --tokens, -n COUNT" >&2
          exit 1
        fi
        ;;

      --runs | -r)

        if [[ -n ${2+x} ]]; then
          args['--runs']="$2"
          shift
          shift
        else
          printf "%s\n" "--runs requires an argument: --runs, -r COUNT" >&2
          exit 1
        fi
        ;;

      --warmups | -w)

        if [[ -n ${2+x} ]]; then
          args['--warmups']="$2"
          shift
          shift
        else
          printf "%s\n" "--warmups requires an argument: --warmups, -w COUNT" >&2
          exit 1
        fi
        ;;

      --loads | -L)

        if [[ -n ${2+x} ]]; then
          args['--loads']="$2"
          shift
          shift
        else
          printf "%s\n" "--loads requires an argument: --loads, -L COUNT" >&2
          exit 1
        fi
        ;;

      --log-path | -l)

        if [[ -n ${2+x} ]]; then
          args['--log-path']="$2"
          shift
          shift
        else
          printf "%s\n" "--log-path requires an argument: --log-path, -l PATH" >&2
          exit 1
        fi
        ;;

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          if [[ -z ${args['model']+x} ]]; then
            args['model']=$1
            shift
          else
            printf "invalid argument: %s\n" "$key" >&2
            exit 1
          fi

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        if [[ -z ${args['model']+x} ]]; then
          args['model']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

        ;;

    esac
  done

  if [[ -z ${args['model']+x} ]]; then
    printf "missing required argument: MODEL\nusage: panther-minor models llm bench MODEL [OPTIONS]\n" >&2

    exit 1
  fi

  if [[ -v args['model'] ]]; then
    validation_output="$(validate_loadable_llm "${args['model']:-}")"
    if [[ -n "$validation_output" ]]; then
      printf "validation error in %s:\n%s\n" "MODEL" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--tokens'] ]]; then
    validation_output="$(validate_integer "${args['--tokens']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--tokens, -n COUNT" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--runs'] ]]; then
    validation_output="$(validate_integer "${args['--runs']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--runs, -r COUNT" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--warmups'] ]]; then
    validation_output="$(validate_integer "${args['--warmups']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--warmups, -w COUNT" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--loads'] ]]; then
    validation_output="$(validate_integer "${args['--loads']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--loads, -L COUNT" "$validation_output" >&2
      exit 1
    fi
  fi

}

