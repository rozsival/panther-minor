panther_minor_models_llm_bench_usage() {
  printf "panther-minor models llm bench - Measure decode and prefill throughput and append it to the baseline log\n\n"

  printf "%s\n" "Usage:"
  printf "  panther-minor models llm bench MODEL [OPTIONS]\n"
  printf "  panther-minor models llm bench --help | -h\n"
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "Options:"

    printf "  %s\n" "--tokens, -n COUNT"
    printf "    Tokens to predict per run (defaults to 256)\n"
    echo

    printf "  %s\n" "--runs, -r COUNT"
    printf "    Measured runs per load, after the warm-ups (defaults to 3)\n"
    echo

    printf "  %s\n" "--warmups, -w COUNT"
    printf "    Discarded warm-up runs per load; throughput ramps for ~7 (defaults to 8)\n"
    echo

    printf "  %s\n" "--loads, -L COUNT"
    printf "    Fresh llama-cpp loads to measure; reports median of per-load medians\n    (defaults to 1)\n"
    echo

    printf "  %s\n" "--log-path, -l PATH"
    printf "    File to append the baseline to (defaults to models/bench.log)\n"
    echo

    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo

    printf "%s\n" "Arguments:"

    printf "  %s\n" "MODEL"
    printf "    Preset name from llama-cpp/preset.ini\n"
    echo

    printf "%s\n" "Examples:"
    printf "  panther-minor models llm bench Qwen3.8-27B\n"
    printf "  panther-minor models llm bench --loads 3 --tokens 512 Qwen3.8-Flash-Next\n"
    echo

  fi
}

