panther_minor_models_llm_bench_completion() {
  local completion_current="$1"
  local completion_arg_index=0
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help | -h)
        completion_blocked_flags["--help"]=1
        shift
        ;;
      --tokens | -n)
        shift
        if [[ $# -eq 0 ]]; then

          return
        fi
        shift
        completion_blocked_flags["--tokens"]=1

        ;;
      --runs | -r)
        shift
        if [[ $# -eq 0 ]]; then

          return
        fi
        shift
        completion_blocked_flags["--runs"]=1

        ;;
      --warmups | -w)
        shift
        if [[ $# -eq 0 ]]; then

          return
        fi
        shift
        completion_blocked_flags["--warmups"]=1

        ;;
      --loads | -L)
        shift
        if [[ $# -eq 0 ]]; then

          return
        fi
        shift
        completion_blocked_flags["--loads"]=1

        ;;
      --log-path | -l)
        shift
        if [[ $# -eq 0 ]]; then

          return
        fi
        shift
        completion_blocked_flags["--log-path"]=1

        ;;
      *)
        if [[ $completion_arg_index -ge 1 ]]; then
          return
        fi
        completion_arg_index=$((completion_arg_index + 1))
        shift

        ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
    completion_flag_candidates --tokens "$completion_current" --tokens -n
    completion_flag_candidates --runs "$completion_current" --runs -r
    completion_flag_candidates --warmups "$completion_current" --warmups -w
    completion_flag_candidates --loads "$completion_current" --loads -L
    completion_flag_candidates --log-path "$completion_current" --log-path -l
  fi

  if [[ $completion_current != -* ]]; then
    case "$completion_arg_index" in
      0)
        if completion_output="$({ panther_complete_llm_presets; } 2>/dev/null)"; then
          completion_dynamic_candidates "$completion_current" "$completion_output"
        fi
        ;;
    esac
  fi

}

