        if [[ -z ${args['service']+x} ]]; then
          args['service']="$escaped"
        else
          args['service']="${args['service']} $escaped"

        fi
        shift

        ;;

    esac
  done

  if [[ -v args['service'] ]]; then
    values=''
    eval "values=(${args['service']})"
    for value in "${values[@]}"; do
      validation_output="$(validate_cluster_service "$value")"
      if [[ -n "$validation_output" ]]; then
        printf "validation error in %s:\n%s\n" "SERVICE" "$validation_output" >&2
        exit 1
      fi
    done
  fi

}

panther_minor_logs_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        panther_minor_logs_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="logs"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --tail | -t)

        if [[ -n ${2+x} ]]; then
          args['--tail']="$2"
          shift
          shift
        else
          printf "%s\n" "--tail requires an argument: --tail, -t LINES" >&2
          exit 1
        fi
        ;;

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          if [[ -z ${args['service']+x} ]]; then
            args['service']=$1
            shift
          else
            printf "invalid argument: %s\n" "$key" >&2
            exit 1
          fi

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        if [[ -z ${args['service']+x} ]]; then
          args['service']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

        ;;

    esac
  done

  if [[ -z ${args['service']+x} ]]; then
    printf "missing required argument: SERVICE\nusage: panther-minor logs SERVICE [OPTIONS]\n" >&2

    exit 1
  fi

  if [[ -v args['service'] ]]; then
    validation_output="$(validate_cluster_service "${args['service']:-}")"
    if [[ -n "$validation_output" ]]; then
      printf "validation error in %s:\n%s\n" "SERVICE" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--tail'] ]]; then
    validation_output="$(validate_integer "${args['--tail']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--tail, -t LINES" "$validation_output" >&2
      exit 1
    fi
  fi

}

panther_minor_update_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        panther_minor_update_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="update"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          if [[ -z ${args['version']+x} ]]; then
            args['version']=$1
            shift
          else
            printf "invalid argument: %s\n" "$key" >&2
            exit 1
          fi

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        if [[ -z ${args['version']+x} ]]; then
          args['version']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

        ;;

    esac
  done

  [[ -n ${args['version']:-} ]] || args['version']="latest"

}

