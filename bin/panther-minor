        return
        ;;
      list)
        shift
        panther_minor_models_llm_list_completion "$completion_current" "$@"
        return
        ;;
      remove)
        shift
        panther_minor_models_llm_remove_completion "$completion_current" "$@"
        return
        ;;
      load)
        shift
        panther_minor_models_llm_load_completion "$completion_current" "$@"
        return
        ;;
      unload)
        shift
        panther_minor_models_llm_unload_completion "$completion_current" "$@"
        return
        ;;
      bench)
        shift
        panther_minor_models_llm_bench_completion "$completion_current" "$@"
        return
        ;;
      --help | -h)
        completion_blocked_flags["--help"]=1
        shift
        ;;
      *)
        return
        ;;
    esac
  done
  completion_candidates "$completion_current" download list remove load unload bench

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
  fi

}

panther_minor_models_llm_download_completion() {
  local completion_current="$1"
  local completion_arg_index=0
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help | -h)
        completion_blocked_flags["--help"]=1
        shift
        ;;
      --force | -f)
        completion_blocked_flags["--force"]=1

        shift
        ;;
      *)
        if [[ $completion_arg_index -ge 1 ]]; then
          return
        fi
        completion_arg_index=$((completion_arg_index + 1))
        shift

        ;;
    esac
  done

  if [[ $completion_current == -* ]]; then
    completion_flag_candidates --help "$completion_current" --help -h
    completion_flag_candidates --force "$completion_current" --force -f
  fi

  if [[ $completion_current != -* ]]; then
    case "$completion_arg_index" in
      0)
        if completion_output="$({ panther_complete_llm_models; } 2>/dev/null)"; then
          completion_dynamic_candidates "$completion_current" "$completion_output"
        fi
        ;;
    esac
  fi

}

