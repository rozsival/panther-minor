panther_minor_models_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        panther_minor_models_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action=${1:-}

  case $action in
    -*) ;;

    llm)
      action="llm"
      shift
      panther_minor_models_llm_parse_requirements "$@"
      shift $#
      ;;

    t2i)
      action="t2i"
      shift
      panther_minor_models_t2i_parse_requirements "$@"
      shift $#
      ;;

    prune)
      action="prune"
      shift
      panther_minor_models_prune_parse_requirements "$@"
      shift $#
      ;;

    "")
      panther_minor_models_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  while [[ $# -gt 0 ]]; do
